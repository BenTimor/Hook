node_modules/
dist/
dist-portable/
dist-waitlist/
waitlist-data/
release/
.tmp/
*.local
.DS_Store

# Cargo workspace output (shared by every product)
target/
apps/*/src-tauri/gen/

# Build-time secrets — never committed
harness.config.toml
cloudflare.ini
.cloudflare.ini

# Bundled coding engine (see scripts/fetch-pi-runtime.mjs)
apps/*/src-tauri/resources/pi-runtime/

# Bundled git for coding agents (see scripts/fetch-git.mjs)
apps/*/src-tauri/resources/git/
.git-runtime-cache/

# Partner Center credentials for `msstore` (README: Microsoft Store)
# tenant id, seller id, client id, client secret — never committed
.env.partner.local

# Generated by the Android build inside a local Tauri plugin module
plugins/*/android/.tauri/
plugins/*/android/build/

# Generated by browser/tools/build.mjs before the Chromium build, never committed:
# the dock bundle and the new tab page's copy of the shared greeting catalog.
browser/overlay/src/hook/resources/panel.mjs
browser/overlay/src/hook/resources/greeting.generated.ts
