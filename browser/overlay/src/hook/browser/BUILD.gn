# Hook Browser: the browser-process half of the WebUI seam.
#
# Nothing in this file is compiled until a patch adds "//hook/browser" to the
# deps of //chrome/browser (and, through it, //chrome/browser/ui/webui:configs).
# That is deliberate: the overlay is inert in a stock checkout, and the patch is
# the one line that wakes it up.

source_set("browser") {
  sources = [
    "account/hook_paths.cc",
    "account/hook_paths.h",
    "channel/hook_channel.cc",
    "channel/hook_channel.h",
    "navigation/hook_sign_in_throttle.cc",
    "navigation/hook_sign_in_throttle.h",
    "tabs/hook_tabs.cc",
    "tabs/hook_tabs.h",
    "ui/views/hook_side_panel.cc",
    "ui/views/hook_side_panel.h",
    "ui/webui/hook_data_source.cc",
    "ui/webui/hook_data_source.h",
    "ui/webui/hook_page_handler.cc",
    "ui/webui/hook_page_handler.h",
    "ui/webui/hook_panel_ui.cc",
    "ui/webui/hook_panel_ui.h",
    "ui/webui/hook_ui.cc",
    "ui/webui/hook_ui.h",
  ]

  public_deps = [
    "//content/public/browser",
    "//ui/webui",
  ]

  deps = [
    "//base",
    "//chrome/browser/profiles:profile",
    # BrowserWindowInterface is the public leaf interface, and the tab strip
    # headers carry the model the live tab list reads.
    "//chrome/browser/ui/browser_window",
    # The side panel: the registry and entry a window owns, the WebUI view that
    # hosts our top-chrome page, and the top-chrome controller/base config.
    "//chrome/browser/ui/side_panel",
    "//chrome/browser/ui/tabs:tab_strip",
    "//chrome/browser/ui/views/side_panel",
    "//chrome/browser/ui/webui/top_chrome",
    "//components/tabs:public",
    "//components/strings",
    "//content/public/common",
    "//hook/common:mojom",
    "//hook/resources:resources",
    "//mojo/public/cpp/bindings",
    "//net",
    "//services/network/public/cpp",
    "//services/network/public/mojom",
    "//ui/base",
    "//ui/views",
    "//url",
  ]
}
