// Hook Browser: the WebUI <-> browser seam for chrome://hook.
//
// Step 1 of docs/browser-poc-plan.md. One method, returning the tabs the
// browser actually has open: it proves the page can read live browser state over
// mojom, which is the transport every later surface (the dock, the side panel,
// the sign-in card) will use. The product contract is the active tab; the whole
// list is the probe.

module hook.mojom;

// One row of the live tab list.
struct Tab {
  // Position in the tabstrip, zero based.
  int32 index;
  // The tab's handle, stable for the life of the tab (not across restarts).
  int32 id;
  // Whether this tab is the selected one.
  bool active;
  // The tab's title as WebContents reports it, possibly empty.
  string title;
  // The committed URL, without its fragment: what the chat agent is told a tab
  // is about, and what a page read is keyed on.
  string url;
  // The host of the last committed URL, without scheme or path.
  string domain;
};

// One row of the dock's history: everything the list needs and nothing else.
struct ChatSummary {
  string id;
  string title;
  // Milliseconds since the epoch, the same number the store keeps. (mojom keeps
  // the IDL spelling in C++, so the field is snake_case here and `updated_at`
  // in C++.)
  double updated_at;
  // A reply is streaming in this chat right now.
  bool busy;
  // The account's cloud sync is off, so this chat is only on this computer.
  bool unsynced;
};

// A message as the dock draws it. Tool calls are deliberately not carried: the
// panel renders the conversation, and the inspector's view of a turn is the
// window's, not the browser's.
struct ChatMessage {
  string id;
  string role;
  string content;
  // complete | streaming | error | aborted
  string status;
  // Hidden messages stay in the store for replay; the dock filters them out.
  bool hidden;
  string error;
};

struct ChatView {
  ChatSummary chat;
  array<ChatMessage> messages;
};

// The sign-in card's whole state.
//
// `available` is whether a Hook app answers on this computer. The browser cannot
// sign in on its own: the device flow, the account file it writes and the token
// all belong to `auth.rs`, so without a running app the card can only say so.
struct SignInView {
  bool signed_in;
  bool available;
  // signed_out | pending | signed_in
  string state;
  // The code the person types in the browser while the flow waits.
  string user_code;
  string verification_url;
  string email;
  string name;
  string message;
};

interface PageHandler {
  // The live tab list of the browser window that hosts this page.
  GetTabs() => (array<Tab> tabs);

  // Called by the page once it has drawn itself. A side panel entry is not
  // shown until its host says so (`WebUIContentsWrapper`), which is how every
  // top-chrome page announces that it is ready; in a tab it is a no-op.
  ShowUI();

  // Whether a running Hook app published its channel. The browser process reads
  // the descriptor and makes the calls; a chrome:// renderer cannot open a
  // socket to loopback at all (Chromium kills it for "Incorrect scheme").
  GetChannel() => (bool available, string reason);

  // The dock's history and one conversation, read from that channel.
  ListChats() => (array<ChatSummary> chats, string error);
  GetChat(string id) => (ChatView? chat, string error);
  CreateChat() => (string id, string error);
  // Starts the turn. The trailing context frame and the page view the agent's
  // browser tools read are built here, from the live tabstrip, so the page never
  // handles a tab handle and cannot point a read at a tab of its choosing.
  SendMessage(string id, string text) => (bool ok, string error);
  StopMessage(string id);

  // The sign-in card: the account file, plus the running app's answer when there
  // is one. Every call re-reads the file, so a page that has just watched an
  // approval can reload and be let through.
  GetSignIn() => (SignInView view);
  // Starts the device flow through the running app and returns the pending view.
  // Nothing is opened here: the page shows the code and offers the link.
  StartSignIn() => (SignInView view, string error);
  // Abandons a pending flow in the app.
  CancelSignIn();
};
