# Hook Browser: the chrome://hook page.
#
# build_webui generates the .grd, the resource map and hook_resources.pak, so
# there is no hand-written .grd to keep in step. chrome/chrome_paks.gni adds
# the pak to the repack (one line in browser/patches/); this target is also a
# dependency there, or the pak is never built.
#
# The mojom is generated in the browser's directory and imported here by
# basename, which is what `webui_module_path = "/"` in //hook/common buys.

import("//ui/webui/resources/tools/build_webui.gni")

build_webui("build") {
  grd_prefix = "hook"

  # A plain page: the stylesheet is a static resource, not a
  # css_to_wrapper module. css_files would pull in Polymer for no reason.
  #
  # panel.html is the same bundle as a document of its own: the side panel
  # (chrome://hook-panel) draws it, chrome://hook draws it in a pane.
  #
  # panel.mjs is the dock from packages/chat, built by `browser/tools/build.mjs`
  # from browser/ui/ before ninja runs (it is generated, not committed — see the
  # README's "The dock bundle"). Chromium's WebUI pipeline compiles Lit and TypeScript and ships
  # no React, so the shared surface travels as a prebuilt bundle. `.mjs` rather
  # than `.js` on purpose: build_webui refuses `.js` in static_files, and
  # text/javascript is what Chromium serves for `.mjs`.
  # Every file in both lists costs a resource id: this .grd's range is reserved
  # in 0003-reserve-hook-resource-ids.patch, and adding a file without widening
  # it fails the build with `IdRangeOverflow` ("used more IDs (11) than were
  # allocated for it (10)") rather than with a message about this list.
  static_files = [
    "hook.css",
    "hook.html",
    "newtab.css",
    "newtab.html",
    "newtab_mark.png",
    "panel.html",
    "panel.mjs",
  ]

  ts_files = [
    "greeting.generated.ts",
    "hook.ts",
    "newtab.ts",
  ]

  mojo_files_deps = [ "//hook/common:mojom_ts__generator" ]
  mojo_files = [ "$root_gen_dir/hook/common/hook.mojom-webui.ts" ]

  # The mojo bindings module, which is what the generated webui mojom imports
  # (`//resources/mojo/mojo/public/js/bindings.js`).
  webui_context_type = "trusted"
  ts_deps = [ "//ui/webui/resources/mojo:build_ts" ]
}
