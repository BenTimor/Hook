# Dev build of Hook Browser. Copied into `out/Dev/args.gn` by tools/build.mjs.
#
# is_component_build is the single biggest iteration win: the browser is then
# a small executable plus DLLs, and a C++ change relinks one module instead of
# linking a 200 MB image. It is dev only — releases are not component builds.
#
# Siso is off on purpose. The overlay reaches the checkout through a Windows
# directory junction, and siso's hashfs follows a junction as an absolute
# symlink outside the source root, which it refuses (`store resolve next dir
# hook failed`). Ninja follows it. With no remote execution on a dev machine
# the difference is scheduling, not the build. Set this back when siso can read
# through a junction.
use_siso = false
#
# The symbol levels are set before the first build on purpose: changing them
# afterwards forces a full recompile of everything.
is_debug = false
is_component_build = true
symbol_level = 0
blink_symbol_level = 0
v8_symbol_level = 0

# Video and audio for the web. Chromium ships without them because the codecs are
# not free to redistribute, not because they are not wanted: with these off,
# H.264 and AAC do not decode, which is every MP4 on the web (X, Instagram,
# TikTok, Vimeo, Teams, most .mp4 links). The H.264 pool charges nothing below
# 100,000 units a year; AAC charges per unit. Both are owed by whoever distributes
# a build, so the dev build carries them and a *release* build does not: it decodes
# through Windows' Media Foundation instead (`docs/browser-os-decoders.md`, the
# decision and its stages). Keeping both in a shipped build is the licensed
# configuration with extra steps, which is the one thing that decision rules out.
# A release build still links FFmpeg for demuxing and keeps `is_component_ffmpeg =
# true`, so it stays a separate, relinkable DLL (LGPL-2.1+).
proprietary_codecs = true
ffmpeg_branding = "Chrome"

# Safe Browsing is off by default, and it is a patch rather than an arg here:
# `safe_browsing_mode = 0` is the honest removal and it does not build in this
# tag — six targets depend on components/safe_browsing unconditionally (four
# browser_tests, interactive_ui_tests, and the shipping
# chrome/browser/feedback/report_unsafe_site), so `gn gen` fails. The switch that
# works is the pref default in
# components/safe_browsing/core/common/safe_browsing_prefs.cc, which is what
# SafeBrowsingServiceImpl::RefreshState() reads to start or stop the service.
# Why off at all, and what it costs: docs/browser-branding.md, "Safe Browsing,
# in full".

# Google's AI is switched off in the patch stack, not here. `enable_compose =
# false` looks like the right knob for "Help me write" and is not: ten BUILD.gn
# files depend on //chrome/browser/compose unconditionally, so the flag makes
# `gn gen` assert. The feature defaults in components/compose/.../compose_features.cc
# are the switch (docs/browser-branding.md, "The AI surfaces").
