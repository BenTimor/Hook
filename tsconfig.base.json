{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["vite/client"],
    "paths": {
      "@hook/ui": ["./packages/ui/src/index.ts"],
      "@hook/ui/*": ["./packages/ui/src/*"],
      "@hook/chat": ["./packages/chat/src/index.ts"],
      "@hook/chat/*": ["./packages/chat/src/*"],
      "@hook/markdown": ["./packages/markdown/src/index.ts"],
      "@hook/markdown/*": ["./packages/markdown/src/*"]
    }
  }
}
