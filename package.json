{
  "name": "hook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Hook \u00e2\u20ac\u201d a local, single-provider AI chat harness",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "waitlist:dev": "vite --config waitlist.vite.config.mjs",
    "waitlist:build": "tsc --noEmit && vite build --config waitlist.vite.config.mjs",
    "waitlist:test": "node --test server/api.test.mjs server/platform.test.mjs",
    "waitlist:start": "node --env-file-if-exists=.env.waitlist.local server/waitlist.mjs",
    "mock": "node dev/mock-provider.mjs",
    "tauri": "node scripts/tauri.mjs",
    "app": "node scripts/tauri.mjs dev",
    "app:build": "node scripts/fetch-pi-runtime.mjs && node scripts/tauri.mjs build",
    "app:portable": "node scripts/fetch-pi-runtime.mjs && node scripts/tauri.mjs build --no-bundle && node scripts/make-portable.mjs",
    "engine": "node scripts/fetch-pi-runtime.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@tauri-apps/api": "2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-opener": "^2.7.2",
    "express": "^5.3.0",
    "google-auth-library": "^10.9.1",
    "lucide-react": "1.70.0",
    "motion": "^14.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.6.0",
    "sonner": "2.0.8",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "vite": "8.3.6",
    "@earendil-works/pi-coding-agent": "1.5.2"
  }
}
