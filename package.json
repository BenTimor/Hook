{
  "name": "hook",
  "private": true,
  "type": "module",
  "description": "Hook \u2014 the desktop products, the shared packages they are built from, and the account service",
  "packageManager": "pnpm@10.28.1",
  "scripts": {
    "dev": "pnpm --dir apps/chat run dev",
    "build": "pnpm --dir apps/chat run build",
    "typecheck": "pnpm -r --if-present run typecheck && pnpm run typecheck:waitlist",
    "typecheck:waitlist": "tsc --noEmit -p tsconfig.waitlist.json",
    "app": "pnpm --dir apps/chat run app",
    "app:build": "pnpm --dir apps/chat run app:build",
    "app:portable": "pnpm --dir apps/chat run app:portable",
    "app:msix": "pnpm --dir apps/chat run app:msix",
    "workspace:dev": "pnpm --dir apps/workspace run dev",
    "workspace:build": "pnpm --dir apps/workspace run build",
    "workspace:app": "pnpm --dir apps/workspace run app",
    "workspace:app:build": "pnpm --dir apps/workspace run app:build",
    "workspace:app:portable": "pnpm --dir apps/workspace run app:portable",
    "engine": "node scripts/fetch-pi-runtime.mjs apps/chat",
    "git": "node scripts/fetch-git.mjs apps/chat",
    "version:bump": "node scripts/bump-version.mjs",
    "release": "bash scripts/release.sh",
    "waitlist:dev": "vite --config waitlist.vite.config.mjs",
    "waitlist:build": "pnpm run typecheck:waitlist && vite build --config waitlist.vite.config.mjs",
    "waitlist:test": "node --test server/api.test.mjs server/platform.test.mjs server/releases.test.mjs server/git.test.mjs server/sync.test.mjs server/workspace.test.mjs",
    "test:release": "node --test scripts/release-gate.test.mjs scripts/merge-release-index.test.mjs scripts/site-source-hash.test.mjs",
    "waitlist:start": "node --env-file-if-exists=.env.waitlist.local server/waitlist.mjs",
    "mock": "node dev/mock-provider.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "express": "^5.3.0",
    "google-auth-library": "^10.9.1",
    "lucide-react": "catalog:",
    "motion": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.5.2",
    "@tauri-apps/cli": "2.12.4",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
