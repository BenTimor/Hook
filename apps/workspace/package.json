{
  "name": "@hook/workspace-app",
  "private": true,
  "version": "0.1.8",
  "type": "module",
  "description": "Hook Workspace — projects, boards, tasks and documents, with Hook's chat beside them",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "app": "node ../../scripts/tauri.mjs dev",
    "app:runtime": "node ../../scripts/fetch-git.mjs . && node ../../scripts/fetch-pi-runtime.mjs .",
    "app:bundle": "node ../../scripts/tauri.mjs build",
    "app:build": "pnpm run app:runtime && pnpm run app:bundle",
    "app:portable": "pnpm run app:runtime && node ../../scripts/tauri.mjs build --no-bundle && node ../../scripts/make-portable.mjs --product workspace",
    "app:msix": "pnpm run app:runtime && node ../../scripts/tauri.mjs build --no-bundle && node ../../scripts/build-msix.mjs --product workspace"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "@fontsource-variable/inter": "catalog:",
    "@fontsource-variable/jetbrains-mono": "catalog:",
    "@hook/chat": "workspace:*",
    "@hook/ui": "workspace:*",
    "@tauri-apps/api": "catalog:",
    "lucide-react": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-markdown": "catalog:",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "catalog:",
    "zustand": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/vite": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:"
  }
}
