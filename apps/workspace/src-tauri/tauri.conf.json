{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Hook Workspace",
  "mainBinaryName": "Hook Workspace",
  "version": "0.1.1",
  "identifier": "app.hook.workspace",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1430",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Hook Workspace",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "dragDropEnabled": false,
        "backgroundColor": "#f5efe5"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "copyright": "Hook",
    "category": "Productivity",
    "shortDescription": "Projects, tasks and documents that work with Hook",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "compression": "lzma"
      }
    },
    "resources": {
      "resources/pi-runtime": "pi-runtime",
      "resources/git": "git"
    }
  }
}
