{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "HookCode",
  "mainBinaryName": "HookCode",
  "version": "0.1.0",
  "identifier": "app.hook.mobile",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:1421",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Hook",
        "width": 390,
        "height": 844,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "backgroundColor": "#f5efe5"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "copyright": "Hook",
    "category": "Productivity",
    "shortDescription": "Hook — your conversations and your Workspace",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
