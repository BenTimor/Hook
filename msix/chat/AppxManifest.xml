<?xml version="1.0" encoding="utf-8"?>
<!--
  Template for the Microsoft Store MSIX identity. scripts/build-msix.mjs fills
  the placeholders from msix/<product>/identity.json and package.json.

  Identity.Name and Identity.Publisher must match the values Partner Center
  shows on the product's Package identity page, character for character.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  xmlns:desktop6="http://schemas.microsoft.com/appx/manifest/desktop/windows10/6"
  xmlns:virtualization="http://schemas.microsoft.com/appx/manifest/virtualization/windows10"
  xmlns:uap17="http://schemas.microsoft.com/appx/manifest/uap/windows10/17"
  IgnorableNamespaces="uap rescap desktop6 virtualization uap17"
>
  <Identity
    Name="{{IDENTITY_NAME}}"
    Publisher="{{PUBLISHER}}"
    Version="{{VERSION}}"
    ProcessorArchitecture="{{ARCH}}"
  />

  <Properties>
    <DisplayName>HookCode</DisplayName>
    <PublisherDisplayName>{{PUBLISHER_DISPLAY_NAME}}</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>

    <!--
      MSIX never services a package that is in use: an update that finds
      Hook.exe (or a bundled node.exe still running an agent) fails with
      ERROR_PACKAGES_IN_USE (0x80073D02), which the Store reduces to "try
      again". `defer` tells Windows to hold the update and finish it once Hook
      closes instead. It is honoured on Windows 11 24H2 (build 26100) and
      later; older Windows ignores the element, which is why the in-app Store
      button closes Hook before it hands over.
    -->
    <uap17:UpdateWhileInUse>defer</uap17:UpdateWhileInUse>

    <!--
      Chats, auth.json, projects.json and agent sessions live in the roaming
      AppData folder under app.hook.chat. MSIX normally redirects AppData writes
      into a per-package folder, which would hide an existing install's history
      and split it from the direct build. This is a full-trust desktop app, so
      it opts out for its own folder; on Windows 10 the broader AppData opt-out
      is the only mechanism available.
    -->
    <desktop6:FileSystemWriteVirtualization>disabled</desktop6:FileSystemWriteVirtualization>
    <virtualization:FileSystemWriteVirtualization>
      <virtualization:ExcludedDirectories>
        <virtualization:ExcludedDirectory>$(KnownFolder:RoamingAppData)\{{DATA_FOLDER}}</virtualization:ExcludedDirectory>
      </virtualization:ExcludedDirectories>
    </virtualization:FileSystemWriteVirtualization>
  </Properties>

  <Dependencies>
    <!--
      The Evergreen WebView2 Runtime is preinstalled on Windows 11 and on
      Windows 10 machines with Edge. An MSIX cannot run Tauri's bootstrapper,
      so the Store listing states the requirement instead of chaining an
      installer that Microsoft's own docs warn is unreliable on Windows 10.
    -->
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="10.0.19041.0"
      MaxVersionTested="10.0.22621.0"
    />
  </Dependencies>

  <Resources>
    <Resource Language="en-us" />
  </Resources>

  <Applications>
    <Application Id="Hook" Executable="{{EXECUTABLE}}" EntryPoint="Windows.FullTrustApplication">
      <!--
        Not "transparent": Windows fills the app-list/taskbar icon plate with
        this colour, and transparent resolves to the user's accent colour —
        which painted a red ring around the rounded corners of Hook's mark.
        The Square44x44Logo.targetsize-*_altform-* assets drop the plate
        entirely (scripts/msix-icons.mjs); this is the fallback for surfaces
        that keep one, and the Store description page uses it too.
      -->
      <uap:VisualElements
        DisplayName="HookCode"
        Description="HookCode — a local AI chat harness with coding agents."
        BackgroundColor="#191817"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
      >
        <uap:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" />
      </uap:VisualElements>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Hook runs a bundled Node runtime and coding agents in project folders,
         and keeps its data in the same AppData folder as the direct build. -->
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>
</Package>
