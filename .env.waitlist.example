WAITLIST_ORIGIN=http://localhost:5173
# Local dev server only: skip Google and keep choices in memory (no database/storage writes).
WAITLIST_DEV_MODE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
WAITLIST_SESSION_SECRET=
# WAITLIST_DB_PATH=waitlist-data/signups.sqlite
# Set true only after the public unlimited-usage policy has been defined.
# VITE_WAITLIST_UNLIMITED_USAGE=false

# Desktop API proxy. Requests from approved Hook users are forwarded to this
# DeepSeek-compatible endpoint with DEEPSEEK_API_KEY; the model sent by the app
# is ignored and replaced with DEEPSEEK_MODEL.
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_API_KEY=
# The single model id Hook and its coding agent see. Must match [model] name in
# harness.config.toml.
HOOK_MODEL_ID=hook
# Optional limits advertised to the app. Keep [coding] in harness.config.ci.toml
# in step if you change them.
# HOOK_CONTEXT_WINDOW=1048576
# HOOK_MAX_OUTPUT_TOKENS=393216

# Windows installer + latest.json uploaded by the release workflow. Inside the
# container this is /data/releases (bind-mounted from /opt/hook-web/data).
# DOWNLOAD_DIR=data/releases
